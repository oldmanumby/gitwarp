{
  "name": "app-gitwarp",
  "version": "1.3.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build:docs": "rm -rf docs_temp && blume build --base /docs && mv dist docs_temp",
    "build:app": "bun run scripts/build.ts",
    "build": "bun run build:docs && bun run build:app && mv docs_temp dist/docs",
    "test": "bun test"
  },
  "devDependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "blume": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "lucide": "^1.21.0"
  }
}
